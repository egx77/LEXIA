{
  "name": "lexia-counsel",
  "version": "0.1.0",
  "private": true,
  "description": "LEXIA Counsel — MVP prototype implementing Framework v2.0 (FD 01–09). Synthetic data only.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "node --experimental-strip-types scripts/reset-db.ts",
    "smoke": "node scripts/smoke.mjs",
    "db:backup": "node scripts/backup.mjs backup",
    "db:verify": "node scripts/backup.mjs verify",
    "db:restore": "node scripts/backup.mjs restore",
    "evidence": "node scripts/evidence.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "docx": "^9.15.4",
    "jszip": "^3.10.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
