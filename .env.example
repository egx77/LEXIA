# Where the embedded Postgres (PGlite) stores data. Use memory:// for ephemeral.
LEXIA_DATA_DIR=./.data/pg
# development | test | pilot | production — fault simulation is disabled in production.
LEXIA_ENV=development
# Seed synthetic fixtures (FD 07 §6) on first start. Never seed real client data.
LEXIA_SEED_FIXTURES=true
